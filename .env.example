# Database
SQL_PASSWORD=
SQL_CONNECTION_STRING=

# Elasticsearch
ELASTIC_URI=
# Optional, only needed when Elasticsearch security is enabled
ELASTIC_USERNAME=
ELASTIC_PASSWORD=

# JWT (at least 32 characters)
JWT_SECURITY_KEY=

# MediatR
MEDIATR_LICENSE_KEY=

# First SuperAdmin (used only while no SuperAdmin exists)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Origin of the management UI
CORS_ALLOWED_ORIGIN=http://localhost:3000
