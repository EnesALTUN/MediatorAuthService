    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Application\MediatorAuthService.Application\MediatorAuthService.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MediatorAuthService.UnitTests" />
  </ItemGroup>
