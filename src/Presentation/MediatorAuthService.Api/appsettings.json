{
  "JwtTokenOption": {
    "Audience": [ "mediator.auth" ],
    "Issuer": "mediator.auth",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30,
    "SecurityKey": ""
  },
  "Lockout": {
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Seed": {
    // Bootstraps the first SuperAdmin while none exists. Provide through user secrets or environment variables.
    "AdminEmail": "",
    "AdminPassword": ""
  },
  "Database": {
    // Migrate | EnsureCreated | None
    "InitializationMode": "Migrate"
  },
  "HttpsRedirection": {
    "Enabled": true
  },
  "MediatR": {
    "LicenseKey": ""
  },
  "ElasticSearch": {
    "Uri": "http://localhost:9200",
    "Username": "",
    "Password": ""
  },
  "OpenTelemetry": {
    // e.g. http://localhost:4317. Traces and metrics are exported only when set.
    "OtlpEndpoint": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        // If you wish to log database queries, you can enable the following details. However, this may affect performance, so use it with caution.
        //"Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
